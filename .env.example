# Copy to .env and fill in. The app refuses to start if DATABASE_URL or GEMINI_API_KEY is missing.

# Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=<api_key>

# Postgres credentials used by docker compose
POSTGRES_USER=docrag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docrag

# Used when running the API, tests or alembic on the host.
# Inside compose the api service overrides the host with `db`.
DATABASE_URL=postgresql+asyncpg://docrag:change-me@localhost:5432/docrag